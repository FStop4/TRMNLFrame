{% comment %}Frame landscape (16:9, 2560x1440 reported). Sizes use vh so the layout scales to whatever pixel size the renderer uses. Colors stay near the six Spectra 6 inks: black, white, red, yellow, blue, green.{% endcomment %}
{% capture moon_svg2 %}<svg viewBox="0 0 48 48" style="width:11vh;height:11vh;flex:none"><clipPath id="lit"><path d="M24 2 A22 22 0 0 {{ s1 }} 24 46 A{{ mrx }} 22 0 0 {{ s2 }} 24 2 Z"/></clipPath><circle cx="24" cy="24" r="22" fill="#000"/><path d="M24 2 A22 22 0 0 {{ s1 }} 24 46 A{{ mrx }} 22 0 0 {{ s2 }} 24 2 Z" fill="#f5d000"/><g clip-path="url(#lit)" fill="none" stroke="#000" stroke-width="1.2"><circle cx="30" cy="14" r="3.5"/><circle cx="35" cy="26" r="4.5"/><circle cx="27" cy="36" r="3"/><circle cx="20" cy="22" r="2"/><circle cx="38" cy="36" r="2"/><circle cx="14" cy="34" r="2.5"/></g><circle cx="24" cy="24" r="22" fill="none" stroke="#000" stroke-width="1.6"/></svg>{% endcapture %}
<style>
.fr{position:relative;display:flex;width:100vw;height:100vh;overflow:hidden;background:#fff;color:#000;font-family:Georgia,'Times New Roman','Liberation Serif','DejaVu Serif',serif}
.fr *{box-sizing:border-box;margin:0}
.fr-ph{flex:0 0 62.5%;height:100%;background:#fff center/cover no-repeat;position:relative}
.fr-cr{position:absolute;left:2vh;bottom:2vh;background:#fff;padding:.4vh 1.4vh;font-size:1.9vh;font-style:italic}
.fr-pn{flex:1;min-width:0;display:flex;flex-direction:column;padding:1.8vh 3vh 1.6vh;border-left:.6vh solid #000}
.fr-mast{text-align:center;border-bottom:.4vh solid #000;padding-bottom:.9vh}
.fr-mast h1{font-size:3.9vh;line-height:1.05;letter-spacing:.8vh;text-transform:uppercase}
.fr-mast p{font-size:2.3vh;font-style:italic;margin-top:.3vh}
.fr-sec{border-bottom:.2vh solid #000;padding:1.1vh 0}
.fr-hd{font-size:1.8vh;letter-spacing:.6vh;text-transform:uppercase;font-weight:700;margin-bottom:.5vh}
.fr-frost{display:flex;align-items:center;gap:2.4vh}
.fr-big{font-size:11vh;font-weight:700;line-height:.9;letter-spacing:-.4vh}
.fr-cap{font-size:2.3vh;font-style:italic;line-height:1.2}
.fr-cap b{font-style:normal}
.fr-tag{display:inline-block;margin-top:.5vh;padding:.2vh 1.2vh;font-size:2.1vh;font-weight:700;letter-spacing:.3vh;text-transform:uppercase;color:#fff;background:#d00000}
.fr-ok{background:#1a8a2a}
.fr-wx{font-size:2.1vh;margin-top:.5vh}
.fr-moon{display:flex;align-items:center;gap:2vh;margin-bottom:.5vh}
.fr-moon b{display:block;font-size:3.1vh;line-height:1.1}
.fr-moon i{font-size:2.2vh}
.fr-row{display:flex;align-items:baseline;font-size:2.4vh;margin:.4vh 0}
.fr-dots{flex:1;border-bottom:.3vh dotted #000;margin:0 1vh;transform:translateY(-.5vh)}
.fr-rt{font-weight:700;font-size:2vh;letter-spacing:.2vh;text-transform:uppercase;padding:0 1.1vh;color:#fff}
.fr-best{background:#1a8a2a}.fr-fair{background:#f5d000;color:#000}.fr-shun{background:#d00000}
.fr-nm{font-size:1.9vh;margin-top:.5vh;line-height:1.3}
.fr-item{margin-bottom:.5vh}
.fr-item b{display:block;font-size:2.6vh;line-height:1.1}
.fr-item span{font-size:1.9vh;font-style:italic}
.fr-up{display:flex;align-items:baseline;font-size:2.2vh;margin:.2vh 0}
.fr-foot{margin-top:auto;padding-top:.8vh;font-size:1.9vh;font-style:italic;line-height:1.25}
.fr-foot small{display:block;font-size:1.7vh;letter-spacing:.3vh;text-transform:uppercase;font-style:normal;font-weight:700}
</style>
<div class="fr">
 <div class="fr-ph"{% if pbase != "" %} style="background-image:url('{{ pbase }}/frame-{{ pn }}.jpg')"{% endif %}>{% if pbase != "" %}<div class="fr-cr">Photo: {{ pcredit }} / Unsplash</div>{% endif %}</div>
 <div class="fr-pn">
  <div class="fr-mast"><h1>Garden Almanac</h1><p>{{ ts | date: "%A, %B %-d" }} &middot; {{ place }}</p></div>
  <div class="fr-sec"><div class="fr-hd">Frost Reckoning</div>
   <div class="fr-frost"><div class="fr-big">{{ hero_n }}</div><div><div class="fr-cap">days to {{ hero_label | downcase }}<br><b>{{ hero_date }}</b></div>{% if frost_alert != "" %}<span class="fr-tag">{{ frost_alert }}</span>{% else %}<span class="fr-tag fr-ok">{{ frost_state }}</span>{% endif %}</div></div>
   {% if wx_line != "" or sun_line != "" %}<div class="fr-wx">{{ wx_line }}{% if wx_line != "" and sun_line != "" %} &middot; {% endif %}{{ sun_line }}</div>{% endif %}</div>
  <div class="fr-sec"><div class="fr-hd">The Moon</div>
   <div class="fr-moon">{{ moon_svg2 }}<div><b>{{ moon }}</b><i>in {{ msign }} &middot; {{ mel }}</i></div></div>
   <div class="fr-row">Leafy crops<span class="fr-dots"></span>{% case r_leaf %}{% when 'F' %}<span class="fr-rt fr-best">Best</span>{% when 'A' %}<span class="fr-rt fr-shun">Shun</span>{% else %}<span class="fr-rt fr-fair">Fair</span>{% endcase %}</div>
   <div class="fr-row">Root crops<span class="fr-dots"></span>{% case r_root %}{% when 'F' %}<span class="fr-rt fr-best">Best</span>{% when 'A' %}<span class="fr-rt fr-shun">Shun</span>{% else %}<span class="fr-rt fr-fair">Fair</span>{% endcase %}</div>
   <div class="fr-row">Prune &amp; cut<span class="fr-dots"></span>{% case r_cut %}{% when 'F' %}<span class="fr-rt fr-best">Best</span>{% when 'A' %}<span class="fr-rt fr-shun">Shun</span>{% else %}<span class="fr-rt fr-fair">Fair</span>{% endcase %}</div>
   <div class="fr-nm">Next full moon about {{ nf_s | date: "%b %-d" }} &middot; new moon about {{ nw_s | date: "%b %-d" }}</div></div>
  <div class="fr-sec" style="border-bottom:0"><div class="fr-hd">Plant Now</div>
   {% if now_n == 0 %}<div class="fr-item"><b>Rest the beds</b><span>Nothing due for two weeks</span></div>{% endif %}
   {% assign c = 0 %}{% for e in ev.events %}{% if e.f == 1 %}{% assign anchor = ff %}{% else %}{% assign anchor = lf %}{% endif %}{% assign d = e.w | times: 7 | plus: anchor | minus: today %}{% if d < -14 %}{% assign d = d | plus: 365 %}{% endif %}{% if d >= -14 and d <= 6 and c < 3 %}{% assign c = c | plus: 1 %}<div class="fr-item"><b>{{ e.n }}</b><span>{% case e.a %}{% when 's' %}Start indoors{% when 't' %}Transplant{% when 'd' %}Direct sow{% else %}Plan{% endcase %}{% if e.dp %}, {{ e.dp }} in deep{% endif %}{% if e.sm and soil_i != nil %}{% if soil_i >= e.sm %} &middot; soil ok{% else %} &middot; soil too cold{% endif %}{% endif %}</span></div>{% endif %}{% endfor %}
   <div class="fr-hd" style="margin-top:.9vh">Coming Up</div>
   {% assign c = 0 %}{% for e in ev.events %}{% if e.f == 1 %}{% assign anchor = ff %}{% else %}{% assign anchor = lf %}{% endif %}{% assign d = e.w | times: 7 | plus: anchor | minus: today %}{% if d < -14 %}{% assign d = d | plus: 365 %}{% endif %}{% if d >= 7 and d <= 60 and c < 3 %}{% assign c = c | plus: 1 %}{% assign eday = d | plus: today | minus: 1 | times: 86400 | plus: jan1 %}<div class="fr-up">{{ e.n }}{% if e.a == 's' %} (indoors){% elsif e.a == 't' %} (set out){% endif %}<span class="fr-dots"></span>{{ eday | date: "%b %-d" }}</div>{% endif %}{% endfor %}</div>
  <div class="fr-foot"><small>This month</small>{{ chore }}</div>
 </div>
</div>
